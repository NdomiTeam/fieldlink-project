# This is NDOMI'S OWN Supabase project (reused because a separate project
# couldn't be created due to a billing hold) — same values as Ndomi-App's
# backend/.env. FieldLink's tables live in their own "fieldlink" Postgres
# schema there, not "public", so nothing collides with Ndomi's own data.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string for the SAME project, used once to run
# migrations/*.sql (same value as Ndomi-App's backend/.env DATABASE_URL)
DATABASE_URL=

PORT=4100
NODE_ENV=development

# Must match Ndomi's FIELDLINK_JWT_SECRET exactly (verifies the SSO handoff JWT)
FIELDLINK_JWT_SECRET=

# FieldLink's own secret for the longer-lived student session token issued
# right after the SSO exchange (not shared with Ndomi)
FIELDLINK_SESSION_SECRET=

# Must match Ndomi's FIELDLINK_WEBHOOK_SECRET exactly (signs outbound status webhooks to Ndomi)
FIELDLINK_WEBHOOK_SECRET=
NDOMI_BASE_URL=https://ndomi.app
NDOMI_WEBHOOK_PATH=/api/field/webhook

# Shared bearer token for calling Ndomi's company-portal/lookup-by-email endpoint.
# Must equal Ndomi's own FIELDLINK_COMPANY_PORTAL_BEARER env var exactly.
NDOMI_FIELD_PORTAL_BEARER=

# Where student browsers land after the SSO redirect completes
FRONTEND_BASE_URL=http://localhost:3000
